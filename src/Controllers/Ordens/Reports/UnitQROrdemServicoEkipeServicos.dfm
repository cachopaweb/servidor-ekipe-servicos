  object IBQROrdemServico: TIBQuery
    Database = DMPrincipal.IBDBPrincipal
    Transaction = DMPrincipal.IBTransPrincipal
    AfterScroll = IBQROrdemServicoAfterScroll
    BufferChunks = 1000
    CachedUpdates = True
    ParamCheck = True
    SQL.Strings = (
      
        'SELECT ORD_DATA, CLI_NOME, FUN_NOME, ORD_VALOR, ORD_CODIGO, ORD_' +
        'OBS, ORD_ESTADO,  ORD_HORAENTREGA, CLI_CNPJ_CPF, ORD_SOLICITACAO' +
        ', ORD_FAT, '
      
        'COALESCE(CLI_FONE, '#39#39')||'#39'  '#39'||COALESCE(CLI_CELULAR, '#39#39') TELEFONE' +
        'S, CLI_ENDERECO, CLI_NUMERO,  CLI_BAIRRO, CID_NOME||'#39'/'#39'||CID_UF ' +
        'CID_DESCRICAO'
      ''
      'FROM ORDENS JOIN CLIENTES ON ORD_CLI = CLI_CODIGO '
      'JOIN FUNCIONARIOS ON ORD_FUN = FUN_CODIGO '
      'LEFT JOIN CIDADES ON CLI_CID = CID_CODIGO'
      ''
      'WHERE ORD_FAT = :CODIGO'
      'ORDER BY ORD_CODIGO')
    Left = 109
    Top = 8
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'CODIGO'
        ParamType = ptUnknown
      end>
    object IBQROrdemServicoORD_DATA: TDateField
      FieldName = 'ORD_DATA'
      Origin = '"ORDENS"."ORD_DATA"'
      DisplayFormat = 'dd/mm/yyyy'
    end
