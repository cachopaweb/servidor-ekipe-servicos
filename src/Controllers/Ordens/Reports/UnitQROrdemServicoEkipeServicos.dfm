  object IBQRResumo: TIBQuery
    Database = DMPrincipal.IBDBPrincipal
    Transaction = DMPrincipal.IBTransPrincipal
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      
        'SELECT REC_TIPO, SUM(REC_VALOR+REC_JUROS-REC_DESCONTOS) VLR_TOTA' +
        'L'
      ''
      'FROM ORDENS JOIN FATURAMENTOS ON ORD_FAT = FAT_CODIGO'
      'JOIN RECEBIMENTOS ON FAT_CODIGO = REC_FAT'
      ''
      
        'WHERE ((ORD_DATAC = '#39'01/01/1900'#39') OR (ORD_DATAC IS NULL)) AND (R' +
        'EC_SITUACAO >= 0 AND REC_SITUACAO < 2) AND ORD_FAT = :FATURA'
      ''
      'GROUP BY REC_TIPO'
      ''
      'ORDER BY REC_TIPO')
    Left = 368
    Top = 8
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'FATURA'
        ParamType = ptUnknown
      end>
    object IBQRResumoREC_TIPO: TIBStringField
      FieldName = 'REC_TIPO'
      Origin = '"RECEBIMENTOS"."REC_TIPO"'
    end
    object IBQRResumoVLR_TOTAL: TIBBCDField
      FieldName = 'VLR_TOTAL'
      ProviderFlags = []
      Precision = 18
      Size = 2
    end
  end
